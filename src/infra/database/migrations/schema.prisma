// Canonical English entity names and fields. Silat enum values are domain codes.
// Application-supplied IDs use fixed-width 26-character strings.

datasource db {
  provider = "postgresql"
}

enum CategoryCode {
  tanding
  ganda
  regu
  jurus_baku
  solo_kreatif
  tunggal
}

enum ScoreType {
  punch
  kick
  drop
  bina
  hukum
  tegur
  kemantapan
  kebenaran
}

enum ScoreStatus {
  pending
  valid
  invalid
}

enum LogOperation {
  create
  update
  delete
}

enum LogStatus {
  success
  failed
}

enum AthleteStatus {
  disqualified
  surrendered
  valid
  pending
}

enum WinnerStatus {
  winner
  loser
  draw
  pending
}

enum MatchScheduleSession {
  morning
  afternoon
  evening
}

enum MatchScheduleStatus {
  pending
  running
  finished
}

enum WeightStatus {
  overweight
  underweight
  surrendered
  valid
  pending
}

model Athletes {
  id           String        @id @db.Char(26)
  national_id  String
  name         String
  gender       Int
  dob          String?
  avatar       String?
  participants Participant[]

  @@map("athletes")
}

model Events {
  id                String            @id @db.Char(26)
  external_id       String
  name              String
  arena             Int?
  contingents       Contingent[]
  participant_teams ParticipantTeam[]
  match_schedules   MatchSchedule[]
  winners           Winner[]

  @@map("events")
}

model FinalScore {
  id                  String          @id @db.Char(26)
  score_type          ScoreType
  score               String
  match_schedule_id   String          @db.Char(26)
  participant_team_id String          @db.Char(26)
  round               Int             @default(1)
  increment           Int             @default(1)
  created_at          Float
  created_by          String          @db.Char(26)
  match_schedule      MatchSchedule   @relation(fields: [match_schedule_id], references: [id])
  participant_team    ParticipantTeam @relation(fields: [participant_team_id], references: [id])
  creator             Users           @relation("FinalScoreCreator", fields: [created_by], references: [id])

  @@map("final_score")
}

model AgeGroup {
  id          String   @id @db.Char(26)
  external_id String
  name        String
  min_age     Float?
  max_age     Float?
  weights     Weight[]

  @@map("age_group")
}

model MatchSchedule {
  id                     String               @id @db.Char(26)
  events_id              String               @db.Char(26)
  weight_id              String               @db.Char(26)
  arena                  Int                  @default(1)
  pool                   Int                  @default(1)
  round                  Int                  @default(1)
  qualification          String
  red_corner             String?              @db.Char(26)
  blue_corner            String?              @db.Char(26)
  date                   String
  session                MatchScheduleSession
  winner                 String?              @db.Char(26)
  next_match_schedule_id String?              @db.Char(26)
  status                 MatchScheduleStatus  @default(pending)
  properties             Json                 @default("{\"red\":{\"status\":\"pending\",\"score\":{\"total\":0,\"properties\":{}},\"winner_status\":{\"status\":\"pending\",\"remarks\":null}},\"blue\":{\"status\":\"pending\",\"score\":{\"total\":0,\"properties\":{}},\"winner_status\":{\"status\":\"pending\",\"remarks\":null}}}")
  created_at             Float
  updated_at             Float
  created_by             String               @db.Char(26)
  updated_by             String               @db.Char(26)

  events                   Events               @relation(fields: [events_id], references: [id])
  weight                   Weight               @relation(fields: [weight_id], references: [id])
  red_corner_info          ParticipantTeam?     @relation("MatchScheduleRedCorner", fields: [red_corner], references: [id])
  blue_corner_info         ParticipantTeam?     @relation("MatchScheduleBlueCorner", fields: [blue_corner], references: [id])
  winner_info              ParticipantTeam?     @relation("MatchScheduleWinner", fields: [winner], references: [id])
  next_match_schedule      MatchSchedule?       @relation("MatchScheduleProgression", fields: [next_match_schedule_id], references: [id])
  previous_match_schedules MatchSchedule[]      @relation("MatchScheduleProgression")
  creator                  Users                @relation("MatchScheduleCreator", fields: [created_by], references: [id])
  updater                  Users                @relation("MatchScheduleUpdater", fields: [updated_by], references: [id])
  scores                   Scores[]
  final_scores             FinalScore[]
  calls                    MatchScheduleCalls[]
  winners                  Winner[]

  @@map("match_schedule")
}

model MatchScheduleCalls {
  id                  String          @id @db.Char(26)
  match_schedule_id   String          @db.Char(26)
  participant_team_id String          @db.Char(26)
  call_count          Int             @default(1)
  created_at          String
  created_by          String          @db.Char(26)
  match_schedule      MatchSchedule   @relation(fields: [match_schedule_id], references: [id])
  participant_team    ParticipantTeam @relation(fields: [participant_team_id], references: [id])
  creator             Users           @relation("MatchScheduleCallsCreator", fields: [created_by], references: [id])

  @@map("match_schedule_calls")
}

model Category {
  id          String       @id @db.Char(26)
  external_id String
  name        String
  min_athlete Int
  max_athlete Int
  code        CategoryCode
  weights     Weight[]

  @@map("category")
}

model WeightClass {
  id          String   @id @db.Char(26)
  external_id String
  name        String
  weights     Weight[]

  @@map("weight_class")
}

model Contingent {
  id                String            @id @db.Char(26)
  external_id       String
  events_id         String            @db.Char(26)
  name              String
  flag              String?
  events            Events            @relation(fields: [events_id], references: [id])
  participant_teams ParticipantTeam[]
  winners           Winner[]

  @@map("contingent")
}

model Logs {
  id               String       @id @db.Char(26)
  operation        LogOperation
  status           LogStatus
  message          String?
  data             Json
  reference_table  String
  reference_column String
  reference_value  String
  created_at       Float
  increment        Int          @default(1)

  @@map("logs")
}

model Participant {
  id                  String          @id @db.Char(26)
  external_id         String
  athletes_id         String          @db.Char(26)
  valid               Boolean         @default(false)
  participant_team_id String          @db.Char(26)
  athletes            Athletes        @relation(fields: [athletes_id], references: [id])
  participant_team    ParticipantTeam @relation(fields: [participant_team_id], references: [id])

  @@index([participant_team_id])
  @@map("participant")
}

model ParticipantTeam {
  id                   String               @id @db.Char(26)
  weight_id            String               @db.Char(26)
  contingent_id        String               @db.Char(26)
  events_id            String               @db.Char(26)
  weight               Weight               @relation(fields: [weight_id], references: [id])
  contingent           Contingent           @relation(fields: [contingent_id], references: [id])
  events               Events               @relation(fields: [events_id], references: [id])
  members              Participant[]
  draws                Draw[]
  scores               Scores[]
  final_scores         FinalScore[]
  red_corner_of        MatchSchedule[]      @relation("MatchScheduleRedCorner")
  blue_corner_of       MatchSchedule[]      @relation("MatchScheduleBlueCorner")
  won_match_schedules  MatchSchedule[]      @relation("MatchScheduleWinner")
  match_schedule_calls MatchScheduleCalls[]
  weight_verifications WeightVerification[]
  winners              Winner[]

  @@map("participant_team")
}

model Roles {
  id          String  @id @db.Char(26)
  name        String
  description String?
  level       Int
  users       Users[]

  @@map("roles")
}

model Scores {
  id                  String          @id @db.Char(26)
  score_type          ScoreType
  score               String
  match_schedule_id   String          @db.Char(26)
  participant_team_id String          @db.Char(26)
  round               Int             @default(1)
  increment           Int             @default(1)
  status              ScoreStatus     @default(pending)
  created_at          Float
  created_by          String          @db.Char(26)
  match_schedule      MatchSchedule   @relation(fields: [match_schedule_id], references: [id])
  participant_team    ParticipantTeam @relation(fields: [participant_team_id], references: [id])
  creator             Users           @relation("ScoreCreator", fields: [created_by], references: [id])

  @@map("scores")
}

model Draw {
  id                    String          @id @db.Char(26)
  pool                  Int             @default(1)
  increment             Int             @default(1)
  participant_team_id   String          @db.Char(26)
  participant_team_info Json
  created_at            Float
  created_by            String          @db.Char(26)
  updated_at            Float?
  updated_by            String?         @db.Char(26)
  participant_team      ParticipantTeam @relation(fields: [participant_team_id], references: [id])
  creator               Users           @relation("DrawCreator", fields: [created_by], references: [id])
  updater               Users?          @relation("DrawUpdater", fields: [updated_by], references: [id])

  @@map("draw")
}

model UserLogin {
  id            String @id @db.Char(26)
  users_id      String @db.Char(26)
  token         String
  refresh_token String
  expired_at    Float
  created_at    Float
  arena         Int
  users_info    Users  @relation(fields: [users_id], references: [id])

  @@map("user_login")
}

model Users {
  id                                String                    @id @db.Char(26)
  name                              String
  username                          String
  password                          String
  roles_id                          String                    @db.Char(26)
  roles_info                        Roles                     @relation(fields: [roles_id], references: [id])
  user_logins                       UserLogin[]
  created_scores                    Scores[]                  @relation("ScoreCreator")
  created_final_scores              FinalScore[]              @relation("FinalScoreCreator")
  created_draws                     Draw[]                    @relation("DrawCreator")
  updated_draws                     Draw[]                    @relation("DrawUpdater")
  created_match_schedules           MatchSchedule[]           @relation("MatchScheduleCreator")
  updated_match_schedules           MatchSchedule[]           @relation("MatchScheduleUpdater")
  created_match_schedule_calls      MatchScheduleCalls[]      @relation("MatchScheduleCallsCreator")
  verified_weights                  WeightVerification[]      @relation("WeightVerifier")
  created_weight_verification_calls WeightVerificationCalls[] @relation("WeightVerificationCallsCreator")

  @@map("users")
}

model Weight {
  id                String               @id @db.Char(26)
  external_id       String
  category_id       String               @db.Char(26)
  age_group_id      String               @db.Char(26)
  weight_class_id   String?              @db.Char(26)
  min_weight        Float?
  max_weight        Float?
  category_info     Category             @relation(fields: [category_id], references: [id])
  age_group_info    AgeGroup             @relation(fields: [age_group_id], references: [id])
  weight_class_info WeightClass?         @relation(fields: [weight_class_id], references: [id])
  participant_teams ParticipantTeam[]
  match_schedules   MatchSchedule[]
  verifications     WeightVerification[]
  winners           Winner[]

  @@map("weight")
}

model WeightVerification {
  id                  String                    @id @db.Char(26)
  participant_team_id String                    @db.Char(26)
  weight_id           String                    @db.Char(26)
  verified_by         String?                   @db.Char(26)
  verified_at         DateTime?
  status              WeightStatus              @default(pending)
  participant_team    ParticipantTeam           @relation(fields: [participant_team_id], references: [id])
  weight              Weight                    @relation(fields: [weight_id], references: [id])
  verifier            Users?                    @relation("WeightVerifier", fields: [verified_by], references: [id])
  calls               WeightVerificationCalls[]

  @@map("weight_verification")
}

model WeightVerificationCalls {
  id                     String             @id @db.Char(26)
  weight_verification_id String             @db.Char(26)
  call_count             Int                @default(1)
  created_at             String
  created_by             String             @db.Char(26)
  weight_verification    WeightVerification @relation(fields: [weight_verification_id], references: [id])
  creator                Users              @relation("WeightVerificationCallsCreator", fields: [created_by], references: [id])

  @@map("weight_verification_calls")
}

model Winner {
  id                  String          @id @db.Char(26)
  events_id           String          @db.Char(26)
  participant_team_id String          @db.Char(26)
  contingent_id       String          @db.Char(26)
  match_schedule_id   String          @db.Char(26)
  weight_id           String          @db.Char(26)
  rank                Float
  winner_status       WinnerStatus    @default(pending)
  events              Events          @relation(fields: [events_id], references: [id])
  participant_team    ParticipantTeam @relation(fields: [participant_team_id], references: [id])
  contingent          Contingent      @relation(fields: [contingent_id], references: [id])
  match_schedule      MatchSchedule   @relation(fields: [match_schedule_id], references: [id])
  weight              Weight          @relation(fields: [weight_id], references: [id])

  @@map("winner")
}
