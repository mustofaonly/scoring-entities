{
  "name": "@musthida/scoring-entities",
  "version": "1.0.4",
  "description": "Shared TypeScript entities and Zod schemass",
  "main": "./dist/index.cjs",
  "scripts": {
    "test": "vitest run",
    "build": "tsup",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test",
    "prepublishOnly": "npm run check && npm run build",
    "test:report": "vitest run --reporter=default --reporter=json --outputFile=./tests/test-results.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mustofaonly/scoring-entities.git"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./prisma/*": "./src/infra/database/migrations/*"
  },
  "files": [
    "dist",
    "src/infra/database/migrations"
  ],
  "keywords": [
    "typescript",
    "zod",
    "entities",
    "pencak silat",
    "martial arts"
  ],
  "author": "Mustofa",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/mustofaonly/scoring-entities/issues"
  },
  "homepage": "https://github.com/mustofaonly/scoring-entities#readme",
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "tsup": "^9.0.0",
    "typescript": "~5.9.3",
    "vitest": "^5.0.5"
  }
}
